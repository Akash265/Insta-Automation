# Copy to .env (git-ignored) and fill in. Names only — never commit values.
# Full inventory: docs/SYSTEM_ARCHITECTURE.md §9

# --- General (Phase 1) ---
BRIEF_ENV=dev
BRIEF_TIMEZONE=Asia/Kolkata
BRIEF_SITE_BASE_URL=
PUBLISH_DAYS=Mon,Tue,Wed,Thu,Fri
CUTOFF_TIME=17:00
PUBLISH_TIME=20:00
BUDGET_PERIODS_FILE=config/budget_periods.yaml

# --- LLM (Phase 1 bake-off / optional drafting) ---
ANTHROPIC_API_KEY=
LLM_ROUTES_FILE=config/llm_routes.yaml
LLM_DAILY_BUDGET_USD=1.50

# --- Voice / TTS (chosen in the P1-05 bake-off) ---
TTS_PROVIDER=
TTS_API_KEY=
TTS_VOICE_ID=

# --- Cloudflare Pages + R2 (P1-12U: scoped tokens only) ---
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CF_PAGES_PROJECT=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=brief-public
R2_PRIVATE_BUCKET=brief-private
R2_PUBLIC_BASE_URL=

# --- Phase 2+ (leave empty until then) ---
DATABASE_URL=
OLLAMA_BASE_URL=http://127.0.0.1:11434
HEALTHCHECKS_PING_URLS=
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
APIFY_TOKEN=
APIFY_ALLOWED_ACTORS=
APIFY_MAX_RUN_USD=0.50
GITHUB_TOKEN=
BRIEF_WORKER_ID=

# --- Phase 6+ ---
IG_USER_ID=
META_APP_ID=
META_APP_SECRET=
BRIEF_TOKEN_KEY=
