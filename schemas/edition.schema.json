          "type": "integer"
        },
        "source_confidence": {
          "maximum": 25,
          "minimum": 0,
          "title": "Source Confidence",
          "type": "integer"
        }
      },
      "required": [
        "significance",
        "source_confidence",
        "freshness",
        "practical_relevance",
        "novelty",
        "audience_fit"
