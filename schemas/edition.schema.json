            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minutes Site"
        },
        "minutes_verify": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
