        "narration": {
          "items": {
            "$ref": "#/$defs/NarrationRef"
          },
          "title": "Narration",
          "type": "array"
        }
      },
      "title": "Media",
      "type": "object"
    },
    "MediaRef": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "key",
        "sha256"
      ],
      "title": "MediaRef",
      "type": "object"
    },
    "NarrationRef": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "minLength": 1,
          "title": "File",
          "type": "string"
        },
        "segment": {
          "minimum": 0,
          "title": "Segment",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "tts_model": {
          "minLength": 1,
          "title": "Tts Model",
          "type": "string"
        },
        "tts_provider": {
          "minLength": 1,
          "title": "Tts Provider",
          "type": "string"
        },
        "voice": {
          "minLength": 1,
          "title": "Voice",
          "type": "string"
        }
      },
      "required": [
        "segment",
        "file",
        "sha256",
        "tts_provider",
        "tts_model",
        "voice"
      ],
      "title": "NarrationRef",
      "type": "object"
    },
    "ProductionLog": {
      "additionalProperties": false,
