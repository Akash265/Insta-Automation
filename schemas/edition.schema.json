{
  "$defs": {
    "Candidate": {
      "additionalProperties": false,
      "properties": {
        "collected_at": {
          "format": "date-time",
          "title": "Collected At",
          "type": "string"
        },
        "eligible": {
          "title": "Eligible",
          "type": "boolean"
        },
        "event_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event At"
        },
        "published_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published At"
        },
        "publisher": {
          "minLength": 1,
          "title": "Publisher",
          "type": "string"
        },
        "rule_code": {
          "anyOf": [
            {
              "pattern": "^R(0[1-9]|1[0-2])$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule Code"
        },
        "source_type": {
          "$ref": "#/$defs/SourceType"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "url": {
          "maxLength": 2048,
          "minLength": 9,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "url",
        "title",
        "publisher",
        "source_type",
        "collected_at",
        "eligible"
      ],
      "title": "Candidate",
      "type": "object"
    },
    "Category": {
      "enum": [
        "model_release",
        "research",
        "open_source",
        "business",
        "policy"
      ],
      "title": "Category",
      "type": "string"
    },
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "claim_text": {
          "maxLength": 400,
          "minLength": 1,
          "title": "Claim Text",
          "type": "string"
        },
        "claim_type": {
          "$ref": "#/$defs/ClaimType"
        },
        "confidence": {
          "anyOf": [
            {
              "enum": [
                "high",
                "medium",
                "low"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "materiality": {
          "enum": [
            "material",
            "minor"
          ],
          "title": "Materiality",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ClaimStatus",
          "default": "unverified"
        },
        "verified_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verified At"
        },
        "verified_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verified By"
        }
      },
      "required": [
        "claim_text",
        "claim_type",
        "materiality"
      ],
      "title": "Claim",
      "type": "object"
    },
    "ClaimStatus": {
      "enum": [
        "unverified",
        "supported",
        "contested",
        "unsupported",
        "withdrawn"
      ],
      "title": "ClaimStatus",
      "type": "string"
    },
    "ClaimType": {
      "enum": [
        "fact",
        "vendor_claim",
        "benchmark_vendor",
        "benchmark_independent",
        "availability",
        "interpretation",
        "forecast",
        "quote"
      ],
      "title": "ClaimType",
      "type": "string"
    },
    "Correction": {
      "additionalProperties": false,
      "properties": {
        "approved_by": {
          "minLength": 1,
          "title": "Approved By",
          "type": "string"
        },
        "corrected_at": {
          "format": "date-time",
          "title": "Corrected At",
          "type": "string"
        },
        "corrected_text": {
          "minLength": 1,
          "title": "Corrected Text",
          "type": "string"
        },
        "original_text": {
          "minLength": 1,
          "title": "Original Text",
          "type": "string"
        },
        "public_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Public Note"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "severity": {
          "enum": [
            "critical",
            "material",
            "minor"
          ],
          "title": "Severity",
          "type": "string"
        },
        "story_rank": {
          "anyOf": [
            {
              "maximum": 7,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Story Rank"
        }
      },
      "required": [
        "severity",
        "original_text",
        "corrected_text",
        "reason",
        "approved_by",
        "corrected_at"
      ],
      "title": "Correction",
      "type": "object"
    },
    "Deployment": {
      "additionalProperties": false,
      "properties": {
        "deployed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deployed At"
        },
        "linkcheck": {
          "default": "not_run",
          "enum": [
            "pass",
            "fail",
            "not_run"
          ],
          "title": "Linkcheck",
          "type": "string"
        },
        "preview_url": {
          "anyOf": [
            {
              "maxLength": 2048,
              "minLength": 9,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Preview Url"
        },
        "production_deploy_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Production Deploy Id"
        }
      },
      "title": "Deployment",
      "type": "object"
    },
    "EventAtBasis": {
      "enum": [
        "stated",
        "inferred",
        "same_as_published",
        "unknown"
      ],
      "title": "EventAtBasis",
      "type": "string"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "excerpt": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Excerpt",
          "type": "string"
        },
        "publisher": {
          "minLength": 1,
          "title": "Publisher",
          "type": "string"
        },
        "retrieved_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retrieved At"
        },
        "source_tier": {
          "maximum": 3,
          "minimum": 1,
          "title": "Source Tier",
          "type": "integer"
        },
        "stance": {
          "enum": [
            "supports",
            "contradicts",
            "context"
          ],
          "title": "Stance",
          "type": "string"
        },
        "url": {
          "maxLength": 2048,
          "minLength": 9,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "url",
        "publisher",
        "source_tier",
        "stance",
        "excerpt"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Experiment": {
      "additionalProperties": false,
      "properties": {
        "candidates": {
          "items": {
            "$ref": "#/$defs/Candidate"
          },
          "title": "Candidates",
          "type": "array"
        },
        "day": {
          "anyOf": [
            {
              "maximum": 14,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Day"
        },
        "eligible_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Eligible Count"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "quiet_day": {
          "default": false,
          "title": "Quiet Day",
          "type": "boolean"
        }
      },
      "title": "Experiment",
      "type": "object"
    },
    "Media": {
      "additionalProperties": false,
      "properties": {
        "cover": {
          "anyOf": [
            {
              "$ref": "#/$defs/MediaRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
