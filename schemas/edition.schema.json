          "default": null,
          "title": "Published At"
        }
      },
      "required": [
        "platform",
        "method"
      ],
      "title": "Publication",
      "type": "object"
    },
    "Review": {
      "additionalProperties": false,
      "properties": {
        "checklist": {
          "additionalProperties": {
            "type": "boolean"
          },
